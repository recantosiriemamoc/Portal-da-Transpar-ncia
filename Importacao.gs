/**
 * IMPORTAÇÃO DOS DADOS REAIS (setembro de 2024 a outubro de 2026)
 * Origem: planilha corrigida PROJETO_RECANTO (livro-caixa de set/2024 a set/2026 e cadastro de associados),
 * completada com a planilha antiga PAGAMENTOS_SIRIEMA (chácaras e celulares) e a prestação de contas de outubro/2026.
 * Saldo de abertura: R$ 2.124,72 em 01/09/2024. Saldo final conferido com o extrato: R$ 4.151,76.
 *
 * importarDadosReais()   -> grava cadastro, campanhas e lançamentos (só roda uma vez)
 * desfazerImportacao()   -> remove tudo o que a importação gravou
 */

function importarDadosReais() {
  const props = PropertiesService.getScriptProperties();
  if (props.getProperty('importacao_real') === 'sim') throw new Error('A importação já foi feita. Para refazer, rode desfazerImportacao() antes.');
  if (props.getProperty('exemplos_carregados') === 'sim') throw new Error('Os dados de exemplo ainda estão na planilha. Rode apagarExemplos() antes de importar.');
  const D = DADOS_REAIS_;
  const agora = agora_();
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const cfg = tabela_('Config');
    const muda = function (k, v) { const r = cfg.rows.filter(function (x) { return x.Chave === k; })[0]; if (r) atualizar_('Config', r._linha, { Valor: v }); };
    props.setProperty('importacao_cfg_saldo', String(config_().saldoInicial));
    props.setProperty('importacao_cfg_abertura', String(config_().dataAbertura));
    muda('saldoInicial', String(D.saldoInicial));
    muda('dataAbertura', D.dataAbertura);

    inserirLote_('Associados', D.associados.map(function (a, i) {
      return { ID: 'I' + ('000' + (i + 1)).slice(-4), Chacara: a.chacara, Nome: a.nome, Celular: a.celular, Mensalidade: a.mensalidade,
        CobrarDesde: a.cobrarDesde, Ativo: a.ativo === false ? 'não' : 'sim', Obs: a.obs, CriadoEm: agora };
    }));
    inserirLote_('Campanhas', D.campanhas.map(function (c) {
      return { ID: c.id.replace('K0', 'KI'), Nome: c.nome, Descricao: c.descricao, Meta: c.meta, Inicio: c.inicio, Status: c.status, CriadoEm: agora };
    }));
    inserirLote_('Lancamentos', D.lancamentos.map(function (l, i) {
      return { ID: 'H' + ('0000' + (i + 1)).slice(-5), Data: l.data, Tipo: l.tipo, Categoria: l.categoria, Campanha: l.campanha ? l.campanha.replace('K0', 'KI') : '',
        Chacara: l.chacara, PagoPor: l.pagoPor, MesReferencia: l.mes, Descricao: l.descricao, Valor: l.valor, Status: 'Ativo', Motivo: '',
        CriadoPor: 'importação', CriadoEm: agora, CanceladoPor: '', CanceladoEm: '' };
    }));
    criarTerrenosDoCadastro_();
    props.setProperty('importacao_real', 'sim');
  } finally { lock.releaseLock(); }
  const r = resumoPublico();
  registrar_('sistema', 'importação', D.lancamentos.length + ' lançamentos, ' + D.associados.length + ' associados, saldo ' + r.saldoAtual);
  Logger.log('Importação concluída: ' + D.associados.length + ' associados, ' + D.lancamentos.length + ' lançamentos.');
  Logger.log('Saldo atual no portal: R$ ' + r.saldoAtual.toFixed(2) + '  (esperado: R$ 4151.76)');
  const ad = adimplencia_(config_(), lancamentosAtivos_()), qtd = function (x) { return ad.filter(function (a) { return a.situacao === x; }).length; };
  Logger.log('Em dia: ' + qtd('em dia') + '  Atrasadas: ' + qtd('atrasado') + '  Inadimplentes: ' + qtd('inadimplente'));
}

function desfazerImportacao() {
  const props = PropertiesService.getScriptProperties();
  const limpa = function (aba, re, col, re2) {
    const t = tabela_(aba);
    const linhas = t.rows.filter(function (r) { return col ? re2.test(String(r[col])) : re.test(String(r.ID)); }).map(function (r) { return r._linha; }).sort(function (a, b) { return b - a; });
    apagarLinhas_(t.sh, linhas);
    mudouDados_();
    return linhas.length;
  };
  const n = limpa('Terrenos', /^T/, 'Associado', /^I\d{4}$/) + limpa('Associados', /^I\d{4}$/) + limpa('Campanhas', /^KI/) + limpa('Lancamentos', /^H\d{5}$/);
  const cfg = tabela_('Config');
  const volta = function (k, v) { const r = cfg.rows.filter(function (x) { return x.Chave === k; })[0]; if (r && v !== null) atualizar_('Config', r._linha, { Valor: v }); };
  volta('saldoInicial', props.getProperty('importacao_cfg_saldo'));
  volta('dataAbertura', props.getProperty('importacao_cfg_abertura'));
  props.deleteProperty('importacao_real');
  registrar_('sistema', 'importação desfeita', n + ' linhas');
  Logger.log('Importação desfeita: ' + n + ' linhas removidas.');
}


